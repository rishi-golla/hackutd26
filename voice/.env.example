# Copy to .env.local (gitignored) and fill in. Never commit the key. Read by the brain (voice/src) and the
# Pipecat worker (voice/pipecat) alike.
NVIDIA_API_KEY=
# VOICE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # fast Nemotron with tool calling; 404 → falls back to nemotron-3-ultra
#   alternatives (ids as listed by GET /v1/models): nvidia/nemotron-nano-3-30b-a3b, nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_THINKING=off
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_TIMEOUT_MS=6000

# Shared Maincloud database by default. For local testing (spec §0.1 decision 17):
# SPACETIMEDB_HOST=ws://127.0.0.1:3001
# SPACETIMEDB_DB_NAME=handoff-local
# SPACETIMEDB_HOST=wss://maincloud.spacetimedb.com
# SPACETIMEDB_DB_NAME=handoff-hackutd26

# EHR_BASE_URL=http://localhost:4100/fhir
# VOICE_API_PORT=8787
# VOICE_W6=on            # off if the bodycam lane runs W6 itself
# VOICE_PROACTIVE=off    # on = unprompted Nemotron advisories (8 words, every 20 s at most)
# DISPLAY_TZ=America/Chicago

# ---- Pipecat worker (voice/pipecat): ears, mouth and eyes ----
# RIVA_VOICE=Magpie-Multilingual.EN-US.Aria
# RIVA_ASR_FUNCTION_ID= / RIVA_ASR_MODEL= / RIVA_TTS_FUNCTION_ID=   # see voice/pipecat/README.md
# RIVA_BOOST_WORDS=epinephrine,amiodarone,...   # clinical vocabulary boost; "" turns it off
# BRAIN_URL=http://127.0.0.1:8787

# Vision (spec §19 Vision): ~1 frame/s from the phone's video to a hosted Nemotron vision model on the same key.
# VISION=on
# VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning   # or nvidia/nemotron-3.5-super-vl-120b-a12b
# VISION_INTERVAL_S=1.0        # 2.0 halves the calls (the free tier is about 40 requests/min per key, §28)
# VISION_API_KEY=              # a second nvapi- key just for vision, if the rate limit bites
# VISION_BASE_URL=             # another OpenAI-compatible endpoint (e.g. a self-hosted Omni on vLLM)

# Pi hub (hub/hub.py): vision frames when no WebRTC video arrives, and the phone page served from the worker
# (GET /phone.html, hub calls proxied) so one https URL carries the whole bodycam.
# HUB_URL=http://<pi>:8000

# WebRTC when the phone and the laptop are not on one network: a TURN relay for both peers.
# ICE_SERVERS=[{"urls":"turn:host:3478","username":"u","credential":"p"}]
# TURN_URL=turn:host:3478  TURN_USER=u  TURN_PASS=p      # the short form of the same
