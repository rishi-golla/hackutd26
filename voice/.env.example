# Speech-to-text: NVIDIA hosted streaming ASR (build.nvidia.com key).
NVIDIA_API_KEY=
# ASR_FUNCTION_ID=bb0837de-8c7b-481f-9ec8-ef5663e9c1fa

# Self-hosted Nemotron 3 Nano Omni (vLLM, OpenAI-compatible). Used for voice turns and vision.
OMNI_BASE_URL=http://localhost:8001/v1
OMNI_MODEL=omni
# OMNI_API_KEY=none

# Self-hosted Kokoro TTS (Kokoro-FastAPI, OpenAI-compatible /v1/audio/speech).
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=af_heart

# Local SpacetimeDB for development. Maincloud only for the real demo.
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DB_NAME=handoff-local

# Mock FHIR EHR (ehr/).
EHR_BASE_URL=http://localhost:4100/fhir

# Optional: Pi hub, used for vision frames when no WebRTC video is coming in.
# HUB_URL=http://<pi>:8000

# VOICE_PORT=7860
# VISION_INTERVAL_S=1.0

# TURN relay (coturn), when phone and worker are on different networks
TURN_URL=
TURN_USER=
TURN_PASS=
