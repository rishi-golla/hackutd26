{
  "name": "handoff-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Handoff workflow agent: W1 destination + pre-arrival alert, W4 handoff report, W6 patient record from the EHR (Nemotron, with template fallback)",
  "scripts": {
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path ../spacetime"
  },
  "dependencies": {
    "spacetimedb": "2.14.*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  }
}
