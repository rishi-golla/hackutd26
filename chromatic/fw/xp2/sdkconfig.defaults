# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.3.0 Project Minimal Configuration
#
CONFIG_APP_PROJECT_VER_FROM_CONFIG=y
CONFIG_APP_PROJECT_VER="0.13.8-xp2"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_CHROMATIC_FW_VER_STR="4.6"
CONFIG_CONSOLE_SORTED_HELP=y
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LV_COLOR_CHROMA_KEY_HEX=0xFF00FF
CONFIG_LV_USE_ASSERT_STYLE=y
CONFIG_LV_SPRINTF_USE_FLOAT=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_QRCODE=y

# --- fw/xp additions ---
# Custom partition table: same nvs/phy_init as stock, 3 MB factory app.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Bluetooth: BLE only, NimBLE host, observer + broadcaster roles only (smallest footprint).
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
# PERIPHERAL must stay on: IDF 5.3 ble_hs_resolv.c needs ble_sm_alg (only built with a connect role)
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y

# Never write radio calibration data into the (private) NVS partition.
CONFIG_ESP_PHY_CALIBRATION_AND_DATA_STORAGE=n
CONFIG_ESP_WIFI_NVS_ENABLED=n

# IRAM: Wi-Fi+BT+medic overflow IRAM by ~8 KB with the Wi-Fi IRAM speed-ups (perf only).
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
# DRAM: the BT controller reserves ~56 KB of static DRAM. Move LVGL's 32 KB static pool to the heap
# (LV_MEM_CUSTOM -> stdlib malloc) so static .data/.bss fits. Medic UI behaviour is unchanged.
CONFIG_LV_MEM_CUSTOM=y


# --- fw/xp2 additions ---
# Wi-Fi CSI for the csi command (costs about STATIC_RX_BUFFER_NUM KB of RAM only while Wi-Fi is up).
CONFIG_ESP_WIFI_CSI_ENABLED=y

# VITALS UI fonts
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_48=y
