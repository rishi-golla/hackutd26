[Unit]
Description=CMX MVP: finger sensor -> BLE oximeter for the Chromatic; RED pre-alert -> LED flash
After=bluetooth.service
Requires=bluetooth.service

[Service]
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -u /home/cmx/pi_oximeter.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
