[Unit]
Description=Handoff finger sensor: heart rate to the Chromatic (Bluetooth) and the hub
After=bluetooth.service
Requires=bluetooth.service

[Service]
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/python3 -u /home/cmx/pi_oximeter.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
