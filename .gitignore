# Tracked: the Pi hub and sensor code and the Chromatic firmware source. Keys, backups and captures stay out.
/*
!/.gitignore
!/README.md
!/hub/
!/chromatic/
/chromatic/*
!/chromatic/pi/
!/chromatic/tools/
/chromatic/tools/*
!/chromatic/tools/pi.sh
!/chromatic/tools/prep-sd.sh
!/chromatic/fw/
/chromatic/fw/*
!/chromatic/fw/xp2/
!/chromatic/fw/flash.sh
/chromatic/fw/xp2/build/
/chromatic/fw/xp2/managed_components/
/chromatic/fw/xp2/sdkconfig
/chromatic/fw/xp2/XP_README.md
/chromatic/fw/xp2/XP2_README.md
/chromatic/fw/xp2/CHANGELOG.md
*.db
*.rvf*
.claude-flow/
.swarm/
__pycache__/
data/
